# ===========================================
# Yoga Fit with Meenu - Environment Variables
# ===========================================
# Copy to .env.local for local development
# NEVER commit real secrets

# Site
NEXT_PUBLIC_SITE_URL=https://yogafitwithmeenu.online
NEXT_PUBLIC_SITE_NAME=Yoga Fit with Meenu

# Cloudflare Account
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# D1 Database (auto-injected by Workers binding in production)
# For local: use wrangler d1

# R2
R2_BUCKET_NAME=yoga-fit-media
R2_PUBLIC_URL=https://your-r2-public-domain.example
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Auth (generate strong random values)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_SECRET=change-me-another-long-random-string

# Cloudflare Turnstile (optional but recommended for forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# WhatsApp / Contact
NEXT_PUBLIC_PHONE=+917678200212
NEXT_PUBLIC_WHATSAPP=917678200212
NEXT_PUBLIC_EMAIL=yoga@yogafitwithmeenu.online

# Admin seed (development only — used with scripts/generate-admin-sql.js)
ADMIN_EMAIL=admin@yogafitwithmeenu.online
ADMIN_PASSWORD=ChangeMeImmediately123!

# ===========================================
# NOTE on Cloudflare bindings (D1 / R2 / KV)
# ===========================================
# D1, R2 and KV are NOT configured via environment variables. They are
# "bindings" configured in wrangler.toml and only work when running under
# `wrangler dev` / `npm run preview` / the deployed Worker — not plain
# `next dev`. See README.md and DEPLOYMENT_GUIDE.md for full setup steps.
